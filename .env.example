# Kalshi API Credentials for AntiGravity Trading Bot
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git — it's already in .gitignore.

# Kalshi API Key ID (from Kalshi developer dashboard)
KALSHI_API_KEY_ID=your_key_id_here

# Kalshi Private Key PEM (RSA-PSS private key)
# Use \n for newlines if pasting inline, or use KALSHI_PRIVATE_KEY_PATH instead
KALSHI_PRIVATE_KEY_PEM=your_private_key_pem_here

# Alternative: path to private key file
# KALSHI_PRIVATE_KEY_PATH=/path/to/your/private_key.pem

# Environment: demo or prod
KALSHI_ENVIRONMENT=demo

# Live trading safety gate: set to "1" to enable REAL order placement.
# DO NOT set to "1" until Phase F checklist in AGENTS.md Section 7 is 100% complete.
KALSHI_LIVE_TRADING=0
