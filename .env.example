# Kalshi API Credentials — copy this file to .env and fill in your values
# Never commit .env to version control (it's gitignored)

# Kalshi API Key ID (from https://demo.kalshi.co or api.elections.kalshi.com)
KALSHI_API_KEY_ID=your_key_id_here

# Documented alias: the auth layer reads KALSHI_API_KEY_ID first, then falls
# back to KALSHI_KEY_ID. Set only one of the two (they must be the same value).
# KALSHI_KEY_ID=your_key_id_here

# RSA Private Key in PEM format (newlines escaped as \n)
# Example: KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
KALSHI_PRIVATE_KEY_PEM=your_private_key_pem_here

# Alternative: path to private key file
# KALSHI_PRIVATE_KEY_PATH=/path/to/your/private_key.pem

# Environment: "demo" (default) or "prod"
KALSHI_ENVIRONMENT=demo

# Set to "1" to arm real order placement on the exchange
# Without this, the OMS runs in dry_run mode (no real orders sent)
KALSHI_LIVE_TRADING=0

# Dashboard exposure notice:
# app.py binds the dashboard to 0.0.0.0:8088 and serves it with NO authentication.
# Every route (including the read-only /api/* status endpoints) is reachable by
# anyone who can reach the host. Run it on localhost, a trusted private network,
# or behind an authenticating reverse proxy — never expose it to the public
# internet.
# NOTE: the bind address/port are hardcoded (0.0.0.0:8088) in app.py's
# __main__ block and in run_live_bot.py; there is no env var to change them.

# Portfolio state file location (optional, defaults to repo root)
# PORTFOLIO_STATE_FILE=/path/to/portfolio_state.json
